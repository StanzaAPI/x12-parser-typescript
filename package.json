{
  "name": "@stanzaapi/x12-parser",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for Healthcare EDI ANSI X12 Parser (837P / 835 / 271)",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "ansi-x12",
    "edi-837p",
    "edi-835",
    "edi-271",
    "hipaa",
    "healthcare-claims",
    "edi-parser",
    "remittance",
    "claims"
  ],
  "author": "Stanza",
  "license": "MIT",
  "homepage": "https://stanzaapi.com/tools/x12-parser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StanzaAPI/x12-parser-typescript.git"
  }
}